.RECIPEPREFIX = >

# ===== lsxd/lsx.c Makefile =====


# ===== CONFIGURATION =====

CC     := clang
TARGET := lx
SRC    := lsx.c

CFLAGS := -Wall -Wextra -Wpedantic -g -O1 -fno-omit-frame-pointer


# ===== DEFAULT BUILD =====

$(TARGET): $(SRC)
>$(CC) $(CFLAGS) $(SRC) -o $@


# ===== STATIC ANALYSIS =====

.PHONY: analyze-scan-build
analyze-scan-build:
>scan-build --use-cc=$(CC) -o ./scan-results $(CC) $(CFLAGS) $(SRC) -o $(TARGET)

.PHONY: analyze-tidy
analyze-tidy:
>clang-tidy $(SRC) \
>    --checks='clang-analyzer-*,bugprone-*,cert-*,performance-*' \
>    --quiet \
>    -- $(CFLAGS)

.PHONY: analyze-cppcheck
analyze-cppcheck:
>cppcheck --enable=all --inconclusive --std=c11 \
>    --suppress=missingIncludeSystem \
>    --error-exitcode=1 \
>    $(SRC)

.PHONY: analyze
analyze: analyze-tidy analyze-cppcheck analyze-scan-build


# ===== DYNAMIC ANALYSIS =====
.PHONY: asan
asan:
>$(CC) $(CFLAGS) -fsanitize=address,undefined $(SRC) -o $(TARGET)-asan
>    ASAN_OPTIONS=detect_leaks=1:abort_on_error=1 \
>    UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1 \
>    ./$(TARGET)-asan

.PHONY: valgrind
valgrind:
>$(CC) -Wall -Wextra -g -O0 $(SRC) -o $(TARGET)-dbg
>valgrind --leak-check=full \
>    --show-leak-kinds=all \
>    --track-origins=yes \
>    --error-exitcode=1 \
>    ./$(TARGET)-dbg


# ===== AGGREGATE =====
.PHONY: check
check:  analyze asan valgrind

.PHONY: clean
clean:
>rm -f $(TARGET) $(TARGET)-asan $(TARGET)-dbg
>rm -rf scan-results

